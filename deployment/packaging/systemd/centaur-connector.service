[Unit]
Description=Centaur Connector
Documentation=https://github.com/shpak86/centaur
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=centaur
Group=centaur
ExecStart=/usr/local/bin/centaur-connector -config /etc/centaur/connector.json
WorkingDirectory=/
# Serve() does not return in normal operation, so an unexpected clean exit is
# treated as a failure worth restarting.
Restart=always
RestartSec=5s
# The connector handles SIGTERM itself and spends up to 10s on a graceful shutdown.
TimeoutStopSec=15s
LimitNOFILE=65536

# Hardening: the connector only dials the gateway and the local Ollama, reads its
# config from /etc and writes only to the journal.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
