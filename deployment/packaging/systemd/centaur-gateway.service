[Unit]
Description=Centaur Gateway
Documentation=https://github.com/shpak86/centaur
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=centaur
Group=centaur
ExecStart=/usr/local/bin/centaur-gateway -config /etc/centaur/gateway.json
WorkingDirectory=/
Restart=on-failure
RestartSec=2s
# The gateway handles SIGTERM itself and spends up to 10s on a graceful shutdown.
TimeoutStopSec=15s
LimitNOFILE=65536

# Hardening: the binary is static, reads its config from /etc and writes only to
# the journal, so it needs no privileges and no writable paths.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
